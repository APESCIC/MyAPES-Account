APP_NAME="MyAPES Account"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://myaccount.myapes.me.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_FROM_NAME="${APP_NAME}"

# OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and OIDC_REDIRECT_URI
# are injected through the Cloudron app environment. Do not copy credentials
# into this shared file, GitHub secrets, release archives or logs.
OIDC_SCOPES=openid,profile,email
OIDC_STAFF_GROUPS=position.staff,position.students,position.volunteers
OIDC_ADMIN_GROUPS=intranet.administrator
OIDC_SUPERADMIN_GROUPS=intranet.superadmin

LDAP_USER_FILTER=(mail=%s)
LDAP_GROUP_ATTRIBUTE=memberOf
LDAP_START_TLS=false
LDAP_SESSION_REVALIDATE_SECONDS=300
LDAP_SESSION_REVALIDATE_IN_LOCAL=false

AUDIT_LOG_RETENTION_DAYS=180
