APP_NAME="MyAPES Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://myapes-account.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@apes.org.uk"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://127.0.0.1:5173

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://myapes-account.test/staff/auth/callback
OIDC_SCOPES=openid,profile,email
OIDC_STAFF_GROUPS=position.staff,position.students,position.volunteers
OIDC_ADMIN_GROUPS=intranet.administrator
OIDC_SUPERADMIN_GROUPS=intranet.superadmin

LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_GROUPS_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(mail=%s)
LDAP_GROUP_ATTRIBUTE=memberOf
LDAP_START_TLS=false
LDAP_SESSION_REVALIDATE_SECONDS=300
LDAP_SESSION_REVALIDATE_IN_LOCAL=false
MODULE_LOCK_SECONDS=15
MODULE_LOCK_WAIT_SECONDS=5
MODULE_PROJECTION_CACHE_SECONDS=30

AUDIT_LOG_RETENTION_DAYS=180
