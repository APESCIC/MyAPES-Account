<?php

namespace Plugins\{{ studly }};

use App\Core\Extensions\Plugins\PluginAbilityFactory;
use App\Core\Extensions\Plugins\PluginManifest;
use App\Core\Extensions\Plugins\PluginNavigationItem;
use App\Core\Extensions\Plugins\PluginServiceProvider;
use App\Core\Extensions\Plugins\PluginSettingsSchema;
{{ dependencyImport }}use Illuminate\Support\Facades\Gate;
use Plugins\{{ studly }}\Dashboard\{{ studly }}ActiveRecordDetector;
use Plugins\{{ studly }}\Models\{{ model }};
use Plugins\{{ studly }}\Policies\{{ policy }};

class {{ studly }}ServiceProvider extends PluginServiceProvider
{
    public function boot(): void
    {
        parent::boot();

        $this->loadViewsFrom(__DIR__.'/../resources/views', '{{ slug }}');
        $this->loadTranslationsFrom(__DIR__.'/../lang', '{{ translationNamespace }}');

        Gate::policy({{ model }}::class, {{ policy }}::class);
    }

    protected function manifest(): PluginManifest
    {
        $a = PluginAbilityFactory::class;

        return PluginManifest::make(
            slug: '{{ slug }}',
            name: '{{ name }}',
            description: '{{ name }} plugin.',
            version: '0.1.0',
            requiresCore: '^0.37.0',
            compatibleModules: {{ modulesList }},
            shippedModules: {{ modulesList }},
            permissions: [
                $a::public('view-own', 'View own {{ name }} records'),
                $a::public('create', 'Create {{ name }} records'),
                $a::staff('view-all', 'View all {{ name }} records'),
                $a::staff('update-all', 'Update all {{ name }} records'),
            ],
{{ dependenciesBlock }}            navigation: [
{{ navigationBlock }}
            ],
            settingsByModule: [
{{ settingsBlock }}
            ],
            translationNamespace: '{{ translationNamespace }}',
            searchKeywordsKey: '{{ translationNamespace }}::plugin.keywords',
            activeRecordDetector: {{ studly }}ActiveRecordDetector::class,
            migrationsPath: dirname(__DIR__).'/database/migrations',
            staffRouteFiles: [
{{ staffRouteFiles }}
            ],
        );
    }
}
