<?php

namespace Plugins\{{ studly }}\Policies;

use App\Core\Accounts\User;
use Plugins\{{ studly }}\Models\{{ model }};

class {{ policy }}
{
    public function viewAny(User $user): bool
    {
        return $user->can('{{ primaryModule }}.{{ slug }}.view-all')
            || $user->can('{{ primaryModule }}.{{ slug }}.view-own');
    }

    public function view(User $user, {{ model }} $record): bool
    {
        if ($user->can('{{ primaryModule }}.{{ slug }}.view-all')) {
            return true;
        }

        return $user->can('{{ primaryModule }}.{{ slug }}.view-own')
            && (int) $record->user_id === (int) $user->id;
    }

    public function create(User $user): bool
    {
        return $user->can('{{ primaryModule }}.{{ slug }}.create');
    }

    public function update(User $user, {{ model }} $record): bool
    {
        return $user->can('{{ primaryModule }}.{{ slug }}.update-all');
    }
}
